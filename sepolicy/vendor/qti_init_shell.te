allow qti_init_shell kmsg_device:chr_file { open write };
allow qti_init_shell sensors_vendor_data_file:dir getattr;
allow qti_init_shell sysfs_devfreq:file setattr;
allow qti_init_shell sysfs_devices_system_cpu:file setattr;
allow qti_init_shell sysfs_input:file setattr;
allow qti_init_shell sysfs_power:file setattr;

set_prop(qti_init_shell, ctl_start_prop);
set_prop(qti_init_shell, ctl_stop_prop);
